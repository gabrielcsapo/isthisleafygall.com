# Public capture configuration only. Never use a private phx_ personal API key.
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=

# Private review storage: use Railway bucket variable references in production.
REVIEW_S3_ENDPOINT=
REVIEW_S3_BUCKET=
REVIEW_S3_REGION=auto
REVIEW_S3_ACCESS_KEY_ID=
REVIEW_S3_SECRET_ACCESS_KEY=
# Server-only, send-only mail credentials and the owner's notification inbox.
RESEND_API_KEY=
REVIEW_FROM_EMAIL=
REVIEW_NOTIFY_TO=
# Optional public Ko-fi page; no payment information is handled by this app.
SUPPORT_URL=
